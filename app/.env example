# ======================
# Gemini configuration
# ======================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# ======================
# SearXNG configuration
# ======================
# URL của service SearXNG (trong docker-compose có thể là http://searxng:8080,
# còn khi chạy local thì có thể là http://localhost:9090)
SEARXNG_BASE_URL=http://localhost:9090

# Ngôn ngữ mặc định cho search
SEARXNG_DEFAULT_LANGUAGE=vi

# Category mặc định (news / general / ... tùy config SearXNG)
SEARXNG_DEFAULT_CATEGORIES=news

# Timeout khi gọi SearXNG (giây)
SEARXNG_TIMEOUT=20

# (nếu bạn đã thêm)
# Độ dài tối đa của search_query dùng cho SearXNG
SEARCH_QUERY_MAX_LEN=260

# Số lượng URL tối đa để crawl nội dung (Top N)
CRAWL_MAX_RESULTS=5
